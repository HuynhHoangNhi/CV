    {
      "parameters": {
        "jsCode": "for (const item of $input.all()) {\n  // Chuẩn hóa số điện thoại về dạng chuẩn (+84)\n  let phone = item.json.output?.phone || item.json.phone || '';\n  phone = String(phone).replace(/[^0-9+]/g, '');\n  if (phone.startsWith('0')) {\n    phone = '+84' + phone.slice(1);\n  }\n\n  // Viết hoa chữ cái đầu cho Họ và Tên\n  let name = item.json.output?.name || item.json.name || '';\n  if (name) {\n    name = String(name).toLowerCase().replace(/(^\\w{1})|(\\s+\\w{1})/g, letter => letter.toUpperCase());\n  }\n\n  item.json.ho_va_ten = name;\n  item.json.so_dien_thoai = phone;\n}\n\nreturn $input.all();"
      },
