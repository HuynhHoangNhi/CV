    {
      "parameters": {
        "jsCode": "const row = $('Get Pending Interview Emails').item.json;\nconst calendarEvents = $input.all();\n\nconst rawDate = String(row[\"Ngày phỏng vấn\"] || \"\").trim();\n\nif (!/^\\d{4}-\\d{2}-\\d{2}$/.test(rawDate)) {\n  return [{\n    json: {\n      status: \"InvalidDate\",\n      message: \"Ngày phỏng vấn không hợp lệ\"\n    }\n  }];\n}\n\nconst interviewDate = rawDate;\n\nconst rawTime = String(row[\"Giờ phỏng vấn\"] || \"\").trim();\nif (!/^\\d{1,2}:\\d{2}$/.test(rawTime)) {\n  return [{ json: { status: \"InvalidTime\", message: \"Giờ phỏng vấn không hợp lệ\" } }];\n}\nconst timeString = rawTime.padStart(5, '0');\nconst newStart = new Date(`${interviewDate}T${timeString}:00+07:00`);\nconst newEnd = new Date(newStart.getTime() + 60 * 60 * 1000);\n\nlet isOverlap = false;\nfor (const event of calendarEvents) {\n  const eventData = event.json;\n  if (!eventData.start || !eventData.end) continue;\n\n  // Bỏ qua sự kiện cả ngày; chỉ so sánh sự kiện có giờ cụ thể.\n  if (!eventData.start.dateTime || !eventData.end.dateTime) continue;\n\n  const existingStart = new Date(eventData.start.dateTime);\n  const existingEnd = new Date(eventData.end.dateTime);\n\n  if (newStart < existingEnd && newEnd > existingStart) {\n    isOverlap = true;\n    break;\n  }\n}\n\nif (isOverlap) {\n  return [{ json: { status: \"Overlap\" } }];\n}\nreturn [{ json: { status: \"Clear\", startTime: newStart.toISOString(), endTime: newEnd.toISOString() } }];"
      },
