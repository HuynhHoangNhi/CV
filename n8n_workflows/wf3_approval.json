    {
      "parameters": {
        "jsCode": "const sheetData = $('Google Sheets Trigger').first().json;\nconst calendarEvents = $input.all();\n\nconst excelDays = Number(sheetData[\"Ngày phỏng vấn\"]);\nconst baseDate = new Date(Date.UTC(1899, 11, 30)); \nbaseDate.setUTCDate(baseDate.getUTCDate() + excelDays);\nconst interviewDate = baseDate.toISOString().split('T')[0]; \n\nconst timeString = sheetData[\"Giờ phỏng vấn\"]; \nconst newStart = new Date(`${interviewDate}T${timeString}:00+07:00`);\nconst newEnd = new Date(newStart.getTime() + 60 * 60 * 1000);\n\nlet isOverlap = false;\n\nif (calendarEvents && calendarEvents.length > 0 && calendarEvents[0].json && calendarEvents[0].json.id) {\n    for (const event of calendarEvents) {\n        const eventData = event.json;\n        if (!eventData.start || !eventData.start.dateTime) continue;\n\n        const existingStart = new Date(eventData.start.dateTime);\n        const existingEnd = new Date(eventData.end.dateTime);\n\n        if (newStart < existingEnd && newEnd > existingStart) {\n            isOverlap = true;\n            break;\n        }\n    }\n}\n\nif (isOverlap) {\n    return [{ json: { status: \"Overlap\" } }];\n} else {\n    return [{ json: { status: \"Clear\", startTime: newStart.toISOString(), endTime: newEnd.toISOString() } }];\n}"
      },
